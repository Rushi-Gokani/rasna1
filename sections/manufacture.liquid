  <div class="footer-manufacturer__info">
    <strong>Mfg.by:</strong> {{ section.settings.manufacturer_name -}}
    <br>
    {{ section.settings.manufacturer_address }}
  </div>

  <div class="footer-manufacturer__fssai">
    <img
      src="{{ section.settings.img | img_url: 'master' }}"
      alt="FSSAI"
      style="max-width: {{ section.settings.logo_width }}px; height: auto;"
    >
    <span>Lic. No. {{ section.settings.license_number }}</span>
