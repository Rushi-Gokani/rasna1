<style>
  .footer-manufacturer {
    font-size: 14px;
    line-height: 1.6;
  }
  .footer-manufacturer__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    flex-direction: column;
    align-items: start;
  }
  .footer-manufacturer__icons .social-media-links {
    display: flex;
    align-items: center;
    column-gap: 8px;
    row-gap: 12px;
    flex-wrap: wrap;
  }
  .footer-manufacturer__note {
    font-size: 13px;
    color: #666;
  }
  .footer-manufacturer__info {
    margin-bottom: 12px;
  }
  .footer-manufacturer__fssai {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  @media screen and (max-width: 600px) {
    .footer-manufacturer {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Manufacturer Footer",
  "settings": [
       {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "FSSAI Logo"
    },
    {
      "type": "text",
      "id": "manufacturer_name",
      "label": "Manufacturer Name",
      "default": "SBD AGRO FOODS."
    },
    {
      "type": "textarea",
      "id": "manufacturer_address",
      "label": "Manufacturer Address",
      "default": "Theri Baba Sawan Singh, Hisar Road, Near NH9, Sirsa, Haryana - 125055."
    },
    {
      "type": "text",
      "id": "license_number",
      "label": "FSSAI License Number",
      "default": "10818019000120"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "FSSAI Logo Width (px)",
      "min": 30,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },

  ],
  "presets": [
    {
      "name": "Manufacturer Footer"
    }
  ]
}
{% endschema %}
