{% schema %}
{
  "name": "Scary Pranky Section",
  "settings": [
    {
      "type": "header",
      "content": "Main Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image_desktop",
      "label": "Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner Image (Mobile)"
    },
    {
      "type": "header",
      "content": "Packaging 1 (Nutri+)"
    },
    {
      "type": "text",
      "id": "pack_1_title",
      "label": "Heading",
      "default": "Rasna Nutri+ 32 Glasses Pack : Including Fruit Beverage Mix & Flavoured Drink Mix"
    },
    {
      "type": "image_picker",
      "id": "pack_1_image",
      "label": "Instruction Image"
    },
    {
      "type": "header",
      "content": "Packaging 2 (Insta Nutri+)"
    },
    {
      "type": "text",
      "id": "pack_2_title",
      "label": "Heading",
      "default": "Rasna Insta Nutri+ 500g Pack : Instant Fruit Beverage Mix"
    },
    {
      "type": "image_picker",
      "id": "pack_2_image",
      "label": "Instruction Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Terms & Conditions - Rasna Pranky Offer & chance to get mega scary pranky"
    },
    {
      "type": "richtext",
      "id": "terms_conditions",
      "label": "Terms & Conditions",
      "default": "<p><strong>i.</strong> Rasna Pvt. Ltd. has included one Pranky free inside each pack of Rasna Nutri+ (32 Glasses Pack) and Rasna Insta Nutri (500g Pack) manufactured from December 2025 onwards. The Pranky is provided free of cost and no additional amount is charged to the consumer for the same.</p><p><strong>ii. Nature of the Pranky</strong><br>The Pranky is a non-edible novelty item. Children or individuals should not lick, taste, chew, or put the Pranky in their mouth, as the material may not be suitable for ingestion or for every individual's body.</p><p><strong>iii. Choking Hazard Warning</strong><br>The Pranky is a small item and may pose a choking hazard, especially for young children. Adult supervision is advised. Rasna Pvt. Ltd. shall not be responsible for any misuse of the Pranky.</p><p><strong>iv. Representation Disclaimer</strong><br>The size, color, and appearance of the Pranky shown on the product pack, website, or promotional material are representative and for creative visualization purposes only. The actual Pranky may vary.</p><p><strong>v. User-Generated Content & Risk</strong><br>Any videos, photos, or content created and uploaded by consumers featuring the Pranky are done entirely at their own risk. Rasna Pvt. Ltd. shall not be responsible for any injury, loss, damage, or consequence arising from such activities.</p><p><strong>vi. Contest Participation</strong><br>Participation in any contest related to the Pranky is voluntary. Rasna Pvt. Ltd. is not forcing or compelling any customer to participate.</p><p><strong>vii. Selection of Winners & Prizes</strong><br>The selection of winners and distribution of prizes shall be solely at the discretion of Rasna Pvt. Ltd. All participants agree to abide by the decisions taken by the company's management team, which shall be final and binding.</p><p><strong>viii. General Disclaimer</strong><br>Rasna Pvt. Ltd. reserves the right to modify, withdraw, or discontinue the offer or contest at any time without prior notice, subject to applicable laws.</p><p><strong>ix. Legal Disclaimer & Terms</strong><br>In the event of any dispute arising out of or relating to the absence of “Pranky” from the Rasna Nutri+ 32 Glasses Pack and/or Rasna Insta Nutri+ 500 g Pack, the customer acknowledges and agrees that: The customer shall be solely responsible for the quality, content, and originality of any reel and/or video created and uploaded by them.<br>By uploading and/or submitting the reel/video, the customer provides their free, voluntary, and irrevocable consent to Rasna to use, reproduce, publish, display, and share the same on Rasna’s official social media platforms and promotional channels, without any further compensation.<br>Participation does not guarantee selection or receipt of any prize, including but not limited to the “Mega Scary Pranky,” which shall be subject to Rasna’s sole discretion and applicable terms.<br>Rasna shall not be liable for any technical issues, quality defects, or upload-related errors in the reel/video.<br>All disputes, if any, shall be subject to the exclusive jurisdiction of the courts at Ahmedabad, Gujarat, India.</p>"
    }
  ],
  "presets": [
    {
      "name": "Scary Pranky Section"
    }
  ]
}
{% endschema %}

<div class="scary-pranky-section">
  <div class="scary-pranky-banner">
    {% if section.settings.banner_image_desktop != blank %}
      <div class="banner-desktop {% if section.settings.banner_image_mobile != blank %}hidden-mobile{% endif %}">
        {{ section.settings.banner_image_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', width: section.settings.banner_image_desktop.width, height: section.settings.banner_image_desktop.height, class: 'w-full h-auto' }}
      </div>
    {% endif %}
    
    {% if section.settings.banner_image_mobile != blank %}
      <div class="banner-mobile {% if section.settings.banner_image_desktop != blank %}hidden-desktop{% endif %}">
        {{ section.settings.banner_image_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', width: section.settings.banner_image_mobile.width, height: section.settings.banner_image_mobile.height, class: 'w-full h-auto' }}
      </div>
    {% endif %}
  </div>

  <div class="scary-pranky-content page-width">
    
    <div class="scary-pranky-packs">
      {% if section.settings.pack_1_image != blank or section.settings.pack_1_title != blank %}
        <div class="pack-item">
          {% if section.settings.pack_1_title != blank %}
            <h3 class="pack-title">{{ section.settings.pack_1_title }}</h3>
          {% endif %}
          
          {% if section.settings.pack_1_image != blank %}
            <div class="pack-image">
               {{ section.settings.pack_1_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'w-full h-auto' }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.pack_2_image != blank or section.settings.pack_2_title != blank %}
        <div class="pack-item">
          {% if section.settings.pack_2_title != blank %}
            <h3 class="pack-title">{{ section.settings.pack_2_title }}</h3>
          {% endif %}
          
          {% if section.settings.pack_2_image != blank %}
            <div class="pack-image">
               {{ section.settings.pack_2_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'w-full h-auto' }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.title != blank %}
      <h2 class="scary-pranky-title">{{ section.settings.title }}</h2>
    {% endif %}
    
    <div class="scary-pranky-text rte">
      {{ section.settings.terms_conditions }}
    </div>
  </div>
</div>

<style>
  .scary-pranky-section {
    width: 100%;
    margin-bottom: 40px;
  }
  
  .scary-pranky-banner img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scary-pranky-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .scary-pranky-packs {
    margin-bottom: 50px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pack-item {
    width: 100%;
  }

  .pack-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 15px;
    color: #000;
  }

  .pack-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  .scary-pranky-title {
    text-align: center;
    font-size: 28px;
    margin-bottom: 30px;
    font-weight: bold;
    color: #333;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  .scary-pranky-text {
    font-size: 16px;
    line-height: 1.6;
    color: #444;
  }
  
  .scary-pranky-text p {
    margin-bottom: 15px;
  }
  
  .scary-pranky-text strong {
    font-weight: 700;
  }

  @media screen and (min-width: 750px) {
    .hidden-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .hidden-mobile {
      display: none !important;
    }
    
    .scary-pranky-title {
      font-size: 24px;
    }
    
    .scary-pranky-content {
      padding: 30px 15px;
    }

    .pack-title {
      font-size: 18px;
    }
  }
</style>
