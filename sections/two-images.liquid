{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif
%}

{%- style -%}
  .m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-gap: {{ section.settings.image_gap }}px;
    --image-gap-mobile: {{ section.settings.image_gap_mobile }}px;
  }

  .m-section-{{ section.id }} .m-two-images__container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--image-gap, 20px);
    width: 100%;
  }

  .m-section-{{ section.id }} .m-two-images__image {
    flex: 1 1 0;
  }

  .m-section-{{ section.id }} .m-two-images__image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .m-section-{{ section.id }} .m-two-images__heading {
    margin: 0 0 12px 0;
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--m-color-text);
  }

  {% for block in section.blocks %}
    #m-block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      flex: 0 0 calc({{ block.settings.width }}% - (var(--image-gap, 20px) / 2));
      max-width: calc({{ block.settings.width }}% - (var(--image-gap, 20px) / 2));
    }
  {% endfor %}

  @media (max-width: 767px) {
    .m-section-{{ section.id }} .m-two-images__container {
      gap: var(--image-gap-mobile, 10px);
    }

    {% if section.settings.mobile_layout == 'stack' %}
    .m-section-{{ section.id }} .m-two-images__image {
      flex: 1 1 100% !important;
      max-width: 100% !important;
    }
    {% else %}
    .m-section-{{ section.id }} .m-two-images__image {
      flex: 1;
      max-width: calc(50% - (var(--image-gap-mobile, 10px) / 2)) !important;
    }
    {% endif %}
  }
{%- endstyle -%}

<section id="m-section-{{ section.id }}" class="m-section m-two-images m-section-{{ section.id }} m-gradient m-color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
  <div class="{{ section.settings.container }} m-section-my m-section-py">
    {% if section.settings.heading != blank %}
      <div class="m-section__header m:text-center{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        <h2 class="m-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="m-two-images__wrapper{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-two-images__container">
        {% for block in section.blocks %}
          <div id="m-block-{{ block.id }}" class="m-two-images__image" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3 class="m-two-images__heading m:text-center">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.image != blank %}
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
              {% render 'responsive-image', image: block.settings.image, image_class: 'm:w-full m:h-full' %}
              {% if block.settings.link != blank %}</a>{% endif %}
            {% else %}
              <div class="m-two-images__placeholder">
                {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two Images",
  "tag": "section",
  "class": "shopify-section-two-images",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "container-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        {
          "label": "Extra small",
          "value": "h5"
        },
        {
          "label": "Small",
          "value": "h4"
        },
        {
          "label": "Medium",
          "value": "h3"
        },
        {
          "label": "Large",
          "value": "h2"
        },
        {
          "label": "Extra large",
          "value": "h1"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 12,
      "max": 48,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "Gap between images (mobile)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Stack vertically"
        },
        {
          "value": "inline",
          "label": "Side by side"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Image Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "50",
          "options": [
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "40", "label": "40%" },
            { "value": "50", "label": "50%" },
            { "value": "60", "label": "60%" },
            { "value": "67", "label": "67%" },
            { "value": "75", "label": "75%" },
            { "value": "100", "label": "100%" }
          ]
        },
        {
          "type": "header",
          "content": "Block Padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Padding Top",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding Bottom",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Images",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}