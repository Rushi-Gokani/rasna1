{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif
%}

{%- style -%}
  #m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #m-section-{{ section.id }} .m-two-images__wrapper {
    width: 100%;
  }

  #m-section-{{ section.id }} .m-two-images__container {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.image_gap }}px;
    width: 100%;
  }

  #m-section-{{ section.id }} .m-two-images__image--first {
    flex: 0 0 {{ section.settings.image_1_width }}%;
    max-width: {{ section.settings.image_1_width }}%;
  }

  #m-section-{{ section.id }} .m-two-images__image--second {
    flex: 0 0 {{ section.settings.image_2_width }}%;
    max-width: {{ section.settings.image_2_width }}%;
  }

  #m-section-{{ section.id }} .m-two-images__image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  #m-section-{{ section.id }} .m-two-images__heading {
    margin: 0 0 12px 0;
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--m-color-text);
    text-align: center;
  }

  #m-section-{{ section.id }} .m-two-images__image {
    text-align: center;
  }

  #m-section-{{ section.id }} .m-two-images__image a {
    display: block;
    width: 100%;
  }

  @media (max-width: 767px) {
    #m-section-{{ section.id }} .m-two-images__container {
      gap: {{ section.settings.image_gap_mobile }}px;
    }

    {% if section.settings.mobile_layout == 'stack' %}
    #m-section-{{ section.id }} .m-two-images__image--first,
    #m-section-{{ section.id }} .m-two-images__image--second {
      flex: 1 1 100%;
      max-width: 100%;
    }
    {% else %}
    #m-section-{{ section.id }} .m-two-images__image--first,
    #m-section-{{ section.id }} .m-two-images__image--second {
      flex: 1 1 50%;
      max-width: 50%;
    }
    {% endif %}
  }
{%- endstyle -%}

<section id="m-section-{{ section.id }}" class="m-section m-two-images m-gradient m-color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
  <div class="{{ section.settings.container }} m-section-my m-section-py">
    {% if section.settings.heading != blank %}
      <div class="m-section__header m:text-center{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        <h2 class="m-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="m-two-images__wrapper{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-two-images__container">
        <div class="m-two-images__image m-two-images__image--first">
          {% if section.settings.image_1_heading != blank %}
            <h3 class="m-two-images__heading m-two-images__heading--first">{{ section.settings.image_1_heading }}</h3>
          {% endif %}
          {% if section.settings.image_1 != blank %}
            {% if section.settings.image_1_link != blank %}<a href="{{ section.settings.image_1_link }}">{% endif %}
            {% render 'responsive-image', image: section.settings.image_1, image_class: 'm:w-full m:h-full' %}
            {% if section.settings.image_1_link != blank %}</a>{% endif %}
          {% else %}
            <div class="m-two-images__placeholder">
              {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        </div>

        <div class="m-two-images__image m-two-images__image--second">
          {% if section.settings.image_2_heading != blank %}
            <h3 class="m-two-images__heading m-two-images__heading--second">{{ section.settings.image_2_heading }}</h3>
          {% endif %}
          {% if section.settings.image_2 != blank %}
            {% if section.settings.image_2_link != blank %}<a href="{{ section.settings.image_2_link }}">{% endif %}
            {% render 'responsive-image', image: section.settings.image_2, image_class: 'm:w-full m:h-full' %}
            {% if section.settings.image_2_link != blank %}</a>{% endif %}
          {% else %}
            <div class="m-two-images__placeholder">
              {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

