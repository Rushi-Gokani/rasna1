{% if header_settings.show_custom_menu %}
  <style>
    .m-header__custom-menu {
      margin-left: 12px;
    }
    .m-header__custom-menu-link {
      display: flex;
      align-items: center;
      padding: 5px 12px; text-align: center;
      background-color: rgba(var(--color-button), 1);
      color: rgb(var(--color-button-text));
      border-radius: 4px;
      font-weight: 500;
      white-space: nowrap;
      transition: opacity 0.2s ease;
    }
    .m-header__custom-menu-link:hover {
      opacity: 0.9;
      color: rgb(var(--color-button-text));
    }
    .m-header__custom-menu-icon svg {
      width: 18px;
      height: 18px;
    }
    .m-header__custom-menu-text {
      margin-left: 6px;
    }
    @media (max-width: 1023px) {
      .m-header__custom-menu {
        margin-left: 0;
        flex-shrink: 1;
        min-width: 0;
      }
      .m-header__custom-menu-link {
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 3px;
      }
      .m-header__custom-menu-text {
        margin-left: 4px;
      }
      .m-header__custom-menu-icon svg {
        width: 14px;
        height: 14px;
      }
    }
  </style>
  <div class="m-header__custom-menu m:flex m:items-center">
    <a href="{{ header_settings.custom_menu_url }}" class="m-header__custom-menu-link">
      {% if header_settings.custom_menu_icon != 'none' %}
        <span class="m-header__custom-menu-icon">
          {% case header_settings.custom_menu_icon %}
            {% when 'store' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            {% when 'phone' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            {% when 'heart' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            {% when 'star' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            {% when 'gift' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 12 20 22 4 22 4 12"/>
                <rect x="2" y="7" width="20" height="5"/>
                <line x1="12" y1="22" x2="12" y2="7"/>
                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
              </svg>
            {% when 'link' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
          {% endcase %}
        </span>
      {% endif %}
      {% if header_settings.custom_menu_text != blank %}
        <span class="m-header__custom-menu-text">{{ header_settings.custom_menu_text }}</span>
      {% endif %}
    </a>
  </div>
{% endif %}